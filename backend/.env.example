# ==================== DATABASE ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=centro_anxur
DB_USER=postgres
DB_PASSWORD=your_password_here

# ==================== FLASK ====================
FLASK_ENV=production
PORT=5000
SECRET_KEY=your_secret_key_here

# ==================== GOOGLE SHEETS ====================
# Copia il JSON delle credenziali Google (scaricato da Google Cloud Console)
GOOGLE_SHEETS_CREDENTIALS={"type":"service_account","project_id":"..."}
GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# ==================== GOOGLE CALENDAR ====================
GOOGLE_CALENDAR_ID=your_calendar_id_here

# ==================== WILDIX ====================
WILDIX_API_URL=https://your-wildix-server.com/api
WILDIX_API_KEY=your_wildix_api_key_here
WILDIX_WEBHOOK_SECRET=your_webhook_secret_here
